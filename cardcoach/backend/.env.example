# 이 파일을 .env 로 복사하고 값을 채우세요. .env 는 .gitignore 라 GitHub에 안 올라감
GOOGLE_VISION_API_KEY=
# 카카오 로컬(근처 실제 매장 검색). 없으면 seed.py 시연용 좌표로만 GPS 매칭
KAKAO_REST_API_KEY=
# 애매한 사진만 Claude가 사진+근처 매장 목록을 보고 판단. 없으면 규칙 결과 그대로
ANTHROPIC_API_KEY=
# RECOG_MODE=mock
# 관리자 대시보드(localhost:5173/admin) 비밀번호. 배포 서버(Render)에도 같은 이름으로 넣어야 PC에서 배포 기록을 볼 수 있음.
# 비워 두면 이 PC에서 온 요청만 허용
ADMIN_PASSWORD=
# 하루 사진 인식 횟수 제한 (배포용). 비워 두면 제한 없음
# DAILY_RECOG_LIMIT=500
